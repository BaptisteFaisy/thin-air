{
  "name": "@thin-air/core",
  "version": "0.1.0",
  "private": true,
  "description": "Tronc commun du moteur Thin Air : musique (gammes, justesse), événements MusicEvent et mesure d'échantillons. TypeScript pur, sans dépendance, déterministe, aucun son émis.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tradoooo/thin-air.git",
    "directory": "packages/core"
  },
  "keywords": [
    "thin-air",
    "music",
    "midi",
    "dsp",
    "deterministic",
    "typescript",
    "esm"
  ],
  "sideEffects": false,
  "files": [
    "src"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  }
}
