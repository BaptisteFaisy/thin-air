{
  "name": "@thin-air/audio",
  "version": "0.1.0",
  "private": true,
  "description": "Moteur sonore de Thin Air : synthèse hors ligne d'événements MusicEvent en Float32Array, encodage WAV 16 bits, et face Web Audio pour le jeu direct. Aucun son émis par le paquet lui-même.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tradoooo/thin-air.git",
    "directory": "packages/audio"
  },
  "keywords": [
    "thin-air",
    "audio",
    "dsp",
    "wav",
    "web-audio",
    "synthesis",
    "offline-render",
    "typescript",
    "esm"
  ],
  "sideEffects": false,
  "files": [
    "src"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "dependencies": {
    "@thin-air/core": "*"
  }
}
